{
  "base_url": "https://api.example.test/",
  "allowed_hosts": ["api.example.test"],
  "headers_env": {},
  "max_response_bytes": 10485760,
  "timeout_ms": 20000,
  "interval_ms": 500,
  "requests": [
    {"name": "sample-list", "path": "/api/example/list", "method": "GET"},
    {"name": "sample-detail", "path": "/api/example/detail?id=example-id", "method": "GET"},
    {"name": "sample-document", "path": "/files/example-document.pdf", "method": "GET"}
  ]
}
